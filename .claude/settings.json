{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh masday-mem-context",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh pre-tool-use",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".claude/hooks/run.sh workflow-lock",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh workflow-lock",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh skill-wrap-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__masday__workflow_completeTask|mcp__workflow-orchestrator__workflow_complete_task",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh pre-task-complete",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh on-notification",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/run.sh on-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
