[Unit]
Description=Masday Workflow Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=masday
Group=masday
WorkingDirectory=/opt/masday
ExecStart=/usr/local/bin/masday serve
Restart=on-failure
RestartSec=5
# Set these via environment file or override:
# EnvironmentFile=/opt/masday/.env
Environment=DATABASE_URL=postgresql://masday:CHANGE_ME@localhost:5432/masday_workflow
Environment=MASDAY_API_KEY=CHANGE_ME
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
