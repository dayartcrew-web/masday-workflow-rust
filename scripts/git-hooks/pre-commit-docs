#!/usr/bin/env bash
# masday pre-commit docs check — validates .md files are consistent with source
#
# Checks:
# 1. .md files staged alongside source changes (reminds to update docs)
# 2. README.md references match actual crate names/versions
# 3. CLAUDE.md architecture section matches actual files
# 4. Agent .md files reference existing source files
# 5. No dead internal links in .md files

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)
STAGED_MD=$(echo "$STAGED_FILES" | grep '\.md$' || true)
STAGED_SRC=$(echo "$STAGED_FILES" | grep -E '\.(rs|toml|js|ts|cjs|mjs|json|yaml|yml|sh)$' || true)

if [ -z "$STAGED_SRC" ]; then
  # No source changes, skip docs check
  exit 0
fi

ISSUES=0

# ── Check 1: Source changed but no .md updated? ──────────────────────────────
if [ -n "$STAGED_SRC" ] && [ -z "$STAGED_MD" ]; then
  # Only warn for significant source changes (>3 files or Cargo.toml)
  SRC_COUNT=$(echo "$STAGED_SRC" | wc -l)
  HAS_CARGO=$(echo "$STAGED_SRC" | grep -c 'Cargo.toml' || true)

  if [ "$SRC_COUNT" -gt 3 ] || [ "$HAS_CARGO" -gt 0 ]; then
    echo "  [docs] ⚠️  Source changed but no .md files updated"
    echo "         Consider updating: README.md, CLAUDE.md, docs/"
    echo "         Staged source: ${SRC_COUNT} files"
    # Not blocking — just a warning
  fi
fi

# ── Check 2: Dead links in staged .md files ──────────────────────────────────
for md_file in $STAGED_MD; do
  [ -f "$md_file" ] || continue

  # Extract local file links: [text](./path) or [text](path)
  LINKS=$(grep -oE '\]\([^)]*[^h][^t][^t][^p][^s]\)' "$md_file" 2>/dev/null \
    | sed 's/\](\(.*\))/\1/' \
    | grep -v '^#' \
    | grep -v '^http' \
    | grep -v '^mailto' || true)

  for link in $LINKS; do
    # Resolve relative to .md file location
    md_dir=$(dirname "$md_file")
    target="${md_dir}/${link}"

    # Remove anchor
    target=$(echo "$target" | sed 's/#.*$//')

    # Skip empty
    [ -z "$target" ] && continue

    if [ ! -e "$target" ]; then
      echo "  [docs] ✗ Dead link in ${md_file}: ${link}"
      ISSUES=$((ISSUES + 1))
    fi
  done
done

# ── Check 3: CLAUDE.md crate list vs actual ─────────────────────────────────
CLAUDE_MD=".claude/CLAUDE.md"
if [ -f "$CLAUDE_MD" ]; then
  # Get actual crate names from workspace
  ACTUAL_CRATES=$(ls -d masday-*/ 2>/dev/null | sed 's|/$||' | sort || true)
  if [ -n "$ACTUAL_CRATES" ]; then
    for crate in $ACTUAL_CRATES; do
      if ! grep -q "$crate" "$CLAUDE_MD" 2>/dev/null; then
        echo "  [docs] ⚠️  Crate '$crate' not mentioned in .claude/CLAUDE.md"
      fi
    done
  fi
fi

# ── Check 4: README.md version vs Cargo.toml ────────────────────────────────
if [ -f "README.md" ] && [ -f "masday-cli/Cargo.toml" ]; then
  CARGO_VER=$(grep '^version' masday-cli/Cargo.toml | head -1 | sed 's/.*= *"\(.*\)"/\1/')
  if [ -n "$CARGO_VER" ] && ! grep -q "$CARGO_VER" README.md 2>/dev/null; then
    echo "  [docs] ⚠️  README.md doesn't mention version ${CARGO_VER}"
  fi
fi

# ── Check 5: Agent .md files reference existing files ────────────────────────
for agent_md in .claude/agents/*.md; do
  [ -f "$agent_md" ] || continue

  # Extract file references like `path/to/file.rs` or `path/to/file.toml`
  REFS=$(grep -oE '`[a-zA-Z0-9_/.-]+\.(rs|toml|js|ts|cjs)`' "$agent_md" 2>/dev/null \
    | tr -d '`' || true)

  for ref in $REFS; do
    if [ ! -e "$ref" ]; then
      echo "  [docs] ✗ Agent $(basename "$agent_md") references missing file: ${ref}"
      ISSUES=$((ISSUES + 1))
    fi
  done
done

# ── Result ───────────────────────────────────────────────────────────────────
if [ "$ISSUES" -gt 0 ]; then
  echo "  [docs] ✗ ${ISSUES} issue(s) found — fix or update .md files"
  echo "         Skip with: git commit --no-verify"
  exit 1
fi

echo "  [docs] ✓ .md files validated"
exit 0
