#!/usr/bin/env bash
# masday pre-push hook — multi-stack auto-detect + release on tag
# Detects Rust, TypeScript, Python, Go, PHP and runs build + test
# On v* tag push: builds release binaries and creates GitHub Release

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

# --- Tag detection (release pipeline) ---
# Disabled by default. Set MASDAY_RELEASE=1 to enable.
# Example: MASDAY_RELEASE=1 git push origin v0.2.0
#
# To enable permanently, uncomment the block below.
#
# TAG=""
# while IFS=' ' read -r local_ref local_sha remote_ref remote_sha 2>/dev/null || true; do
#   if [[ "$local_ref" == refs/tags/v* ]]; then
#     TAG="${local_ref#refs/tags/}"
#   fi
# done
#
# if [ -n "$TAG" ] && [ "${MASDAY_RELEASE:-}" = "1" ]; then
#   echo "[masday pre-push] 🏷️  Tag detected: $TAG — running release pipeline..."
#   if bash "${ROOT_DIR}/scripts/release.sh" "$TAG"; then
#     echo "[masday pre-push] ✅ Release $TAG created. Pushing tag..."
#     exit 0
#   else
#     echo "[masday pre-push] ❌ Release failed. Aborting push."
#     exit 1
#   fi
# fi

# Consume stdin so git doesn't hang
cat >/dev/null 2>&1 || true

# --- Normal push: detect stacks and run CI ---
STACKS=()
[ -f "Cargo.toml" ] || [ -d "crates" ] 2>/dev/null && STACKS+=("rust")
{ [ -f "pnpm-lock.yaml" ] || [ -f "package-lock.json" ] || [ -f "yarn.lock" ]; } && STACKS+=("ts")
[ -f "pyproject.toml" ] || [ -f "requirements.txt" ] 2>/dev/null && STACKS+=("python")
[ -f "go.mod" ] 2>/dev/null && STACKS+=("go")
[ -f "composer.json" ] 2>/dev/null && STACKS+=("php")

if [ ${#STACKS[@]} -eq 0 ]; then
  echo "[masday pre-push] No known stack detected, skipping checks."
  exit 0
fi

echo "[masday pre-push] Detected stacks: ${STACKS[*]}"

FAILED=0

# --- Rust ---
if [[ " ${STACKS[*]} " =~ " rust " ]]; then
  if command -v cargo &>/dev/null; then
    # Check if release binary is already up-to-date
    CARGO_VERSION="$(cargo metadata --format-version=1 2>/dev/null | python3 -c "import json,sys; pkgs=json.load(sys.stdin)['packages']; print(next((p['version'] for p in pkgs if p['name']=='masday-cli'),''))" 2>/dev/null || echo "")"
    RELEASE_BIN="target/release/masday"
    NEEDS_BUILD=1
    if [ -n "$CARGO_VERSION" ] && [ -f "$RELEASE_BIN" ]; then
      BIN_VERSION="$("$RELEASE_BIN" --version 2>/dev/null | grep -oP '[\d.]+' | head -1 || echo "")"
      if [ "$BIN_VERSION" = "$CARGO_VERSION" ]; then
        echo "  [rust] release binary v${BIN_VERSION} already built — skipping build"
        NEEDS_BUILD=0
      fi
    fi
    if [ "$NEEDS_BUILD" -eq 1 ]; then
      echo "  [rust] cargo build ..."
      cargo build --release --workspace 2>&1 | tail -3 || FAILED=1
    fi
    if [ "$FAILED" -eq 0 ]; then
      echo "  [rust] cargo test ..."
      cargo test --workspace 2>&1 | tail -5 || FAILED=1
    fi
  fi
fi

# --- TypeScript (only if lockfile exists) ---
if [[ " ${STACKS[*]} " =~ " ts " ]]; then
  if [ -f "pnpm-lock.yaml" ] && command -v pnpm &>/dev/null; then
    echo "  [ts] pnpm build ..."
    if ! pnpm build 2>&1 | tail -3; then
      echo "  [ts] ⚠️ pnpm build failed — skipping TS tests"
    else
      echo "  [ts] pnpm test ..."
      pnpm test 2>&1 | tail -5 || echo "  [ts] ⚠️ pnpm test failed"
    fi
  elif [ -f "package-lock.json" ] && [ -f "tsconfig.json" ] && command -v npm &>/dev/null; then
    echo "  [ts] npm run build ..."
    if ! npm run build 2>&1 | tail -3; then
      echo "  [ts] ⚠️ npm build failed — skipping TS tests"
    else
      echo "  [ts] npm test ..."
      npm test 2>&1 | tail -5 || echo "  [ts] ⚠️ npm test failed"
    fi
  fi
fi

# --- Python ---
if [[ " ${STACKS[*]} " =~ " python " ]]; then
  if command -v pytest &>/dev/null; then
    echo "  [python] pytest ..."
    pytest 2>&1 | tail -5 || FAILED=1
  fi
fi

# --- Go ---
if [[ " ${STACKS[*]} " =~ " go " ]]; then
  if command -v go &>/dev/null; then
    echo "  [go] go build ..."
    go build ./... 2>&1 | tail -3 || FAILED=1
    if [ "$FAILED" -eq 0 ]; then
      echo "  [go] go test ..."
      go test ./... 2>&1 | tail -5 || FAILED=1
    fi
  fi
fi

# --- PHP ---
if [[ " ${STACKS[*]} " =~ " php " ]]; then
  if command -v vendor/bin/pest &>/dev/null; then
    echo "  [php] pest ..."
    vendor/bin/pest 2>&1 | tail -5 || FAILED=1
  elif command -v vendor/bin/phpunit &>/dev/null; then
    echo "  [php] phpunit ..."
    vendor/bin/phpunit 2>&1 | tail -5 || FAILED=1
  fi
fi

if [ "$FAILED" -eq 1 ]; then
  echo "[masday pre-push] ❌ Some checks failed."
  exit 1
fi

echo "[masday pre-push] ✅ All checks passed. Pushing..."
