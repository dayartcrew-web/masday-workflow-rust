#!/usr/bin/env bash
# masday pre-commit hook — multi-stack auto-detect
# Detects Rust, TypeScript, Python, Go, PHP and runs appropriate checks

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

# --- Detect stacks ---
STACKS=()
[ -f "Cargo.toml" ] || [ -d "crates" ] 2>/dev/null && STACKS+=("rust")
{ [ -f "pnpm-lock.yaml" ] || [ -f "package-lock.json" ] || [ -f "yarn.lock" ]; } && STACKS+=("ts")
[ -f "pyproject.toml" ] || [ -f "requirements.txt" ] 2>/dev/null && STACKS+=("python")
[ -f "go.mod" ] 2>/dev/null && STACKS+=("go")
[ -f "composer.json" ] 2>/dev/null && STACKS+=("php")

if [ ${#STACKS[@]} -eq 0 ]; then
  echo "[masday pre-commit] No known stack detected, skipping checks."
  exit 0
fi

echo "[masday pre-commit] Detected stacks: ${STACKS[*]}"

# --- Rust ---
if [[ " ${STACKS[*]} " =~ " rust " ]]; then
  if command -v cargo &>/dev/null; then
    echo "  [rust] cargo fmt --check ..."
    cargo fmt --check --all 2>&1 | tail -3 || true
    echo "  [rust] cargo clippy ..."
    cargo clippy --all-targets --all-features -- -D warnings 2>&1 | tail -5 || true
  fi
fi

# --- TypeScript ---
if [[ " ${STACKS[*]} " =~ " ts " ]]; then
  if [ -f "pnpm-lock.yaml" ] && command -v pnpm &>/dev/null; then
    # Run typecheck if script exists, otherwise lint
    if pnpm run --filter "dashboard" lint 2>&1 | tail -3; then
      : # lint passed
    else
      echo "  [ts] ⚠️ lint skipped (pnpm issue)"
    fi
  elif [ -f "tsconfig.json" ] && command -v npx &>/dev/null; then
    echo "  [ts] tsc --noEmit ..."
    npx tsc --noEmit 2>&1 | tail -3 || echo "  [ts] ⚠️ tsc skipped"
  fi
fi

# --- Python ---
if [[ " ${STACKS[*]} " =~ " python " ]]; then
  if command -v ruff &>/dev/null; then
    echo "  [python] ruff check ..."
    ruff check . 2>&1 | tail -3 || true
  elif command -v flake8 &>/dev/null; then
    echo "  [python] flake8 ..."
    flake8 . 2>&1 | tail -3 || true
  fi
fi

# --- Go ---
if [[ " ${STACKS[*]} " =~ " go " ]]; then
  if command -v go &>/dev/null; then
    echo "  [go] go vet ..."
    go vet ./... 2>&1 | tail -3 || true
  fi
fi

# --- PHP ---
if [[ " ${STACKS[*]} " =~ " php " ]]; then
  if command -v php &>/dev/null; then
    echo "  [php] php -l ..."
    find . -name "*.php" -not -path "*/vendor/*" -exec php -l {} \; 2>&1 | grep -v "No syntax errors" | tail -3 || true
  fi
fi

# --- Docs ---
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SCRIPT_DIR}/pre-commit-docs" ]; then
  bash "${SCRIPT_DIR}/pre-commit-docs"
fi

echo "[masday pre-commit] ✅ All checks passed."
