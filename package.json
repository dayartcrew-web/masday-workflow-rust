{
  "name": "masday-workflow-rebuild",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build --filter=\"!@masday-workflow-reborn/*\"",
    "build:apps": "turbo run build --filter=\"@masday-workflow-reborn/*\"",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "pnpm": {
    "overrides": {
      "vite@<=6.4.1": ">=6.4.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "zod": "^3.23.8"
  }
}
