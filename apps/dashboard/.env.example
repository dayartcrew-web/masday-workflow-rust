# Dashboard Environment Configuration
# Copy this to .env.local for local development

# Rust API server URL (masday-api on port 30101)
NEXT_PUBLIC_API_URL=http://localhost:30101

# WebSocket server URL (masday-api WebSocket support)
NEXT_PUBLIC_WS_URL=ws://localhost:30101

# Next.js dev server port (dashboard itself)
PORT=3002
