# Dashboard Environment Configuration
# Copy this to .env.local for local development

# Rust API server URL (masday-api on port 3010)
NEXT_PUBLIC_API_URL=http://localhost:3010

# WebSocket server URL (masday-api WebSocket support)
NEXT_PUBLIC_WS_URL=ws://localhost:3010

# Next.js dev server port (dashboard itself)
PORT=3002
