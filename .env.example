# ═══════════════════════════════════════════════════════════════
# masday-workflow-rebuild — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# All variables have safe defaults for local development.

# ── General ────────────────────────────────────────────────────
# NODE_ENV=development          # development | production | test

# ── Database ───────────────────────────────────────────────────
# DATABASE_URL=sqlite://local   # sqlite://local for dev, postgresql://user:pass@host:port/db for prod
# DB_HOST=localhost             # Database host (PostgreSQL)
# DB_PORT=5432                  # Database port
# DB_USER=postgres              # Database user
# DB_PASSWORD=postgres          # Database password
# DB_NAME=claude_agent_platform # Database name

# ── LLM Provider ──────────────────────────────────────────────
# Primary LLM provider: openai | anthropic | custom
# LLM_PROVIDER=custom
# LLM_API_KEY=                  # API key for primary provider
# LLM_BASE_URL=                 # Custom base URL (required for custom provider)
# LLM_MODEL=                    # Default model name (e.g. gpt-4, claude-sonnet-4-6)

# Model tiers (used by code-skills for cost-aware routing)
# LLM_MODEL_CHEAP=GLM-4.5-Air      # Lightweight tasks
# LLM_MODEL_MEDIUM=glm-4.7          # Standard tasks
# LLM_MODEL_POWERFUL=glm-5          # Complex reasoning

# Fallback LLM provider (optional — used when primary fails)
# LLM_FALLBACK_PROVIDER=            # openai | anthropic | custom
# LLM_FALLBACK_API_KEY=             # API key for fallback provider
# LLM_FALLBACK_BASE_URL=            # Base URL for fallback provider
# LLM_FALLBACK_MODEL=               # Model for fallback provider

# ── Embedding Provider ────────────────────────────────────────
# Provider: mock (default, no API key needed) | openai | ollama
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=text-embedding-3-small   # Model name (e.g. text-embedding-3-small, nomic-embed-text)
# EMBEDDING_DIMENSIONS=768                 # Vector dimensions (768 for OpenAI small, 1536 for large)

# OpenAI-compatible embedding endpoint (used when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=                          # Required for openai provider
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama embedding endpoint (used when EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434   # Ollama API endpoint

# ── API Server ────────────────────────────────────────────────
# API_PORT=3000                          # HTTP server port (fallback: PORT)
# API_WS_PORT=3001                       # WebSocket server port (fallback: WS_PORT)
# MASDAY_STORE_PATH=.masday/state/store.json # JSON store file path

# ── CORS ──────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3002     # Allowed origins (comma-separated)

# ── Frontend (Next.js Dashboard) ─────────────────────────────
# These NEXT_PUBLIC_* vars are baked into the frontend at build time.
# NEXT_PUBLIC_API_URL=http://localhost:3000   # Backend API URL
# NEXT_PUBLIC_WS_URL=ws://localhost:3001      # Backend WebSocket URL

# ── Authentication ────────────────────────────────────────────
# JWT_SECRET=masday-workflow-dev-secret-change-in-production  # MUST change in production
# JWT_EXPIRES_IN=24h                    # Token expiration

# ── MCP / Agent Runner ───────────────────────────────────────
# The agent-runner MCP server reads all the above vars.
# No additional MCP-specific config is needed for local development.
