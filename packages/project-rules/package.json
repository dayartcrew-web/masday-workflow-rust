{
  "name": "@mcp-rebuild/project-rules",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/cli.ts"
  },
  "dependencies": {
    "@mcp-rebuild/core": "workspace:*",
    "@mcp-rebuild/shared-utils": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  }
}
