# =============================================================================
# .env.docker.example — Template for Docker Compose environment variables
# Copy to .env.docker and fill in values before running docker compose up.
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=masday_workflow
DATABASE_URL=postgresql://USER:PASS@postgres:5432/masday_workflow
DB_PORT=5432

# API server (Hono HTTP + WebSocket)
# HTTP port exposed on the host (internal container port is always 3000)
API_PORT=30101
# WebSocket port exposed on the host (internal container port is always 3001)
API_WS_PORT=3002

# Dashboard (Next.js standalone)
DASHBOARD_PORT=3000

# Nginx reverse proxy
NGINX_PORT=80

# MCP server transport mode
MCP_TRANSPORT=stdio

# Node environment
NODE_ENV=production

# LLM Provider (optional — set to anthropic, openai, or custom)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=https://api.anthropic.com

# Dashboard public API URL (used by Next.js client-side)
NEXT_PUBLIC_API_URL=http://localhost:30101
